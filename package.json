{
	"name": "@tasteee/zest",
	"version": "1.0.0",
	"description": "Zest is a gorgeous, fully featured, framework-agnostic web component library. Use it in plain HTML, React, or anywhere else.",
	"type": "module",
	"license": "MIT",
	"author": "tasteee",
	"homepage": "https://github.com/tasteee/zest#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tasteee/zest.git"
	},
	"bugs": {
		"url": "https://github.com/tasteee/zest/issues"
	},
	"keywords": [
		"web-components",
		"custom-elements",
		"atomico",
		"ui",
		"design-system",
		"component-library",
		"zest",
		"ink",
		"tasteink"
	],
	"sideEffects": [
		"./dist/zest.js",
		"./dist/languages.js",
		"./dist/elements/*.js",
		"./dist/ink.css",
		"./dist/fonts.css",
		"./dist/tokens.css",
		"./dist/document.css",
		"./src/**"
	],
	"main": "./dist/zest.js",
	"module": "./dist/zest.js",
	"types": "./dist/index.d.ts",
	"customElements": "custom-elements.json",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/zest.js"
		},
		"./*": {
			"types": "./dist/elements/*.d.ts",
			"import": "./dist/elements/*.js"
		},
		"./zest.js": "./dist/zest.js",
		"./languages": {
			"types": "./dist/languages.d.ts",
			"import": "./dist/languages.js"
		},
		"./ink.css": "./dist/ink.css",
		"./fonts.css": "./dist/fonts.css",
		"./tokens.css": "./dist/tokens.css",
		"./document.css": "./dist/document.css",
		"./react": {
			"types": "./dist/react.d.ts"
		},
		"./custom-elements.json": "./custom-elements.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**",
		"custom-elements.json",
		"README.md",
		"CHANGELOG.md",
		"SUPPORT.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/check-css-templates.mjs && vite build && node scripts/copy-fonts.mjs && tsc -p tsconfig.build.json && node scripts/build-element-types.mjs && node scripts/build-cem.mjs && node scripts/build-jsx-types.mjs && node scripts/build-jsr.mjs && node scripts/check-release-surface.mjs",
		"dev": "vite build && concurrently -k -n lib,site -c blue,green \"vite build --watch\" \"pnpm --filter @tasteee/zest-site dev\"",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:consumers": "node scripts/consumer-smoke.mjs",
		"publish:jsr": "deno publish --allow-slow-types",
		"publish:jsr:dry-run": "deno publish --dry-run --allow-dirty --allow-slow-types",
		"prepublishOnly": "npm run build",
		"prepare": "npm run build",
		"dev:lib": "vite build --watch",
		"dev:site": "pnpm --filter @tasteee/zest-site dev",
		"build:site": "pnpm --filter @tasteee/zest-site build",
		"typecheck:site": "pnpm --filter @tasteee/zest-site typecheck",
		"check:docs": "node scripts/check-docs.mjs"
	},
	"comment": "Atomico is bundled into dist/zest.js; it remains a dependency because the public declaration files reference its types.",
	"dependencies": {
		"atomico": "^2.2.0"
	},
	"devDependencies": {
		"@types/hast": "^3.0.4",
		"@types/node": "^26.0.0",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.0",
		"axe-core": "^4.13.0",
		"concurrently": "^10.0.3",
		"happy-dom": "^20.13.2",
		"highlight.js": "^11.11.1",
		"lowlight": "^3.3.0",
		"marked": "^18.0.5",
		"playwright": "^1.63.0",
		"typescript": "^5.7.3",
		"vite": "^6.0.0",
		"vitest": "^5.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
